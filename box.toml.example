[defaults]
docker = true

# Optional opt-in to existing host configuration. Defaults are isolated under
# ~/.ai-sandbox/claude and ~/.ai-sandbox/codex.
# claude_home = "/path/to/claude-home"
# codex_home = "/path/to/codex-home"

[[workspaces]]
name = "workspace-a"
docker_ports = "18000-18099"

[[workspaces.mounts]]
name = "service-a"
host = "/path/to/workspace-a/service-a"

[[workspaces.mounts]]
name = "service-b"
host = "/path/to/workspace-a/service-b"

[[workspaces]]
name = "workspace-b"
docker_ports = "18100-18199"

[[workspaces.mounts]]
name = "service-c"
host = "/path/to/workspace-b/service-c"

[[workspaces.mounts]]
name = "service-d"
host = "/path/to/workspace-b/service-d"
